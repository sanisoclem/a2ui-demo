{
  "name": "a2ui-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "catalog": "node scripts/write-catalog.ts",
    "db:seed": "node db/write-seed.ts && wrangler d1 execute WAREHOUSE --local --file db/seed.sql",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --strict-vars=false"
  },
  "dependencies": {
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/react": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
